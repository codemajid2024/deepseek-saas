# ==============================================================================
# Configuration SaaS Privé - DeepSeek Harness
# ==============================================================================

# 1. Domaine & Certificat SSL (Let's Encrypt)
# Ex: dsh.mondomaine.com ou localhost si test local
DOMAIN_NAME=dsh.votre-domaine.com
ACME_EMAIL=votre-email@domaine.com

# 2. Authentification Privée (Caddy Basic Auth)
# Nom d'utilisateur pour se connecter
AUTH_USER=admin

# Mot de passe haché (Générez-le avec: docker run --rm caddy:2.9-alpine caddy hash-password --plaintext "VotreMotDePasse")
# Valeur par défaut pour test (mot de passe: "admin123")
AUTH_HASH_PASSWORD=$2a$14$zC0yV9u5eJ4sYl4P0Q2g5ec9K6H4uP0YhT7jQ3hN8kF5gL2wY2Zy.

# 3. Clés API LLM (DeepSeek, OpenAI, etc.)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=
